# Supabase-Projekt (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<projekt>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Nur serverseitig (Server Actions / Route Handler / Server Components).
# Niemals in Client-Komponenten importieren oder mit NEXT_PUBLIC_ prefixen!
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Kommagetrennte Allowlist der Admin-Mailadressen (Vergleich case-insensitive).
ADMIN_EMAILS=admin@example.org,zweite-person@example.org
