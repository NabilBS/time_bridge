# Ohne diese Werte läuft die App im Demo-Modus (nichts wird gespeichert).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Buchungslink für Video-Ident-Termine (z. B. Cal.com), optional
EXPO_PUBLIC_IDENT_BOOKING_URL=

# Rechtstexte (vom Anwalt, gehostet) – Platzhalter bis zum Launch
EXPO_PUBLIC_PRIVACY_URL=   # Datenschutzerklärung
EXPO_PUBLIC_TERMS_URL=     # AGB
EXPO_PUBLIC_IMPRINT_URL=   # Impressum

# Sentry (EU-Region). EXPO_PUBLIC_SENTRY_DSN landet im App-Bundle (Runtime),
# SENTRY_DSN/SENTRY_AUTH_TOKEN nur als EAS-Secrets für Build/Sourcemaps.
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
